rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
  function signed(){ return request.auth != null; }
  function own(){ return signed() && resource.data.userId == request.auth.uid; }
  function creatingOwn(){ return signed() && request.resource.data.userId == request.auth.uid; }
  match /users/{id}{ allow read,write: if signed() && id == request.auth.uid; }
  match /children/{id}{ allow read,update,delete: if own(); allow create: if creatingOwn(); }
  match /routines/{id}{ allow read,update,delete: if own(); allow create: if creatingOwn(); }
  match /routineExecutions/{id}{ allow read,update,delete: if own(); allow create: if creatingOwn(); }
  match /sensorySettings/{id}{ allow read,update,delete: if own(); allow create: if creatingOwn(); }
  match /{document=**}{ allow read,write: if false; }
}}
