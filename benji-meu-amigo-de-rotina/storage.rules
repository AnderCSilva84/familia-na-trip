rules_version = '2'; service firebase.storage { match /b/{bucket}/o {
 match /users/{userId}/children/{childId}/{allPaths=**} { allow read,write: if request.auth != null && request.auth.uid == userId && (request.resource == null || request.resource.size < 15 * 1024 * 1024); }
 match /{allPaths=**}{ allow read,write: if false; }
}}
