rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Avatares/fotos de perfil dos usuarios.
    // Leitura autenticada para que os membros vejam as fotos uns dos outros.
    match /users/{userId}/profile/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Fotos do diario de viagem.
    match /trips/{tripId}/diary/{diaryId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Assets gerais da viagem preparados para capas, proxima parada
    // e imagens de reservas/veiculos quando esses uploads entrarem no app.
    match /trips/{tripId}/covers/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /trips/{tripId}/next-stop/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /trips/{tripId}/hotels/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /trips/{tripId}/vehicles/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /trips/{tripId}/agenda/{eventId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Reserva para importacoes, anexos e backups controlados pelo app.
    match /trips/{tripId}/imports/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
